# offpeak settings. Copy to worker.ini beside offpeak.exe.
#
# Every value here is the built-in default, so the file only needs the lines you
# actually want to change. Section headers are for your eyes: the key names are
# unique across the whole file and the parser does not care which section a line
# is in.
#
# THE NUMBERS IN THIS FILE CAME OFF ONE MACHINE. Every threshold below was
# measured on a single desktop with an RTX 3070 on Windows 11, and is written
# down here rather than buried in the source so that you can change it without a
# compiler. If your card idles differently, these are wrong for you. Run
#   offpeak --calibrate baseline.csv 20
# while you are NOT using the machine, then again while you play, and set them
# from what you see.

# Auto | AlwaysOn | Off. The tray and POST /v1/mode write this line back, so your
# choice survives a reboot.
#
# START WITH Off IF YOU DO NOT TRUST IT YET. In Off mode the agent watches, logs
# every verdict and never takes the GPU, so you can check a week of its opinions
# against a week of your own gaming before you let it run anything.
StartMode            = Auto


# =====================================================================
# [listener]  the HTTPS API
# =====================================================================

ListenerEnabled      = true

# LOOPBACK BY DEFAULT, AND THAT IS A DECISION, NOT TIMIDITY. A non-elevated
# process can bind 0.0.0.0 with no administrator rights, but it CANNOT open the
# Windows Firewall. So a LAN bind is reachable from this machine and nowhere else
# until somebody with administrator rights allows it once, and if a standard user
# is prompted and dismisses it, Windows writes a BLOCK rule and never asks again.
# That failure is permanent and silent. Loopback avoids all of it and still works
# from anywhere over an SSH tunnel:
#
#   ssh -N -L 47600:127.0.0.1:47600 you@thatmachine
#
# Set Bind = 0.0.0.0 only if you also set an ApiKeyFile and AllowedCidrs. The
# agent refuses to start a non-loopback listener without both.
# HOW MANY THREADS THE HUNDRED PER CENT ROW TAKES. 0, the default, means every
# logical thread on the machine.
#
# Measured on an 8 core / 16 thread Ryzen 5700X3D, one model load, no cap, only
# the thread count varying: 8 threads 0.249x realtime, 12 threads 0.271x, and 16
# threads 0.271x. The knee is 12 and 16 costs nothing over it. The rule this
# replaced stopped at the PHYSICAL core count, which was inferred from a sweep on
# a 2016 Xeon and left 9% unclaimed here.
#
# Set it if your chip disagrees. Leaving four threads to the machine costs about
# 0.1% on the one measured, and this row only applies when nobody is signed in.
# CpuThreadsAtFull   = 12

Bind                 = 127.0.0.1
Port                 = 47600

# The bearer token. A file keeps the secret out of a config you might paste into
# a bug report. Leave both unset on loopback; the agent generates a key file for
# you if you set ApiKeyFile and bind beyond loopback.
# ApiKeyFile         = C:\Users\you\AppData\Local\offpeak\api-key.txt
# ApiKey             =

# Who may connect when Bind is not loopback. IPv4 CIDR, comma separated. Empty
# means nobody but loopback.
# AllowedCidrs       = 192.0.2.0/24

# TLS. The agent mints a self-signed certificate on first run into the contained
# directory, touching no certificate store. Clients pin the SHA-256 of it:
#   offpeak fingerprint
# ServerName defaults to this machine's name, detected at run time. Add whatever
# else clients will type in the address bar.
# CertPath           = C:\Users\you\AppData\Local\offpeak\certs\server.pfx
# ServerName         = thatmachine
# CertExtraSans      = thatmachine.lan,192.0.2.11
# CertYears          = 5

# What the CLI on THIS machine uses to reach a runner. Only the client reads
# these; the agent ignores them. Unset means "the local agent".
# ClientHost         = 192.0.2.11
# ClientPort         = 47600
# CertFingerprint    = aa62a67f...   (offpeak fingerprint on the runner prints it)

# Limits for a hand written server that may end up on a LAN. These are the
# slowloris knobs: a client that opens a socket and dribbles one byte a minute is
# stopped by RequestTimeoutMs, and MaxConnections is the whole blast radius of a
# flood, because the policy loop shares no lock with any of this.
MaxRequestBytes      = 8388608
MaxHeaderCount       = 64
MaxHeaderLineBytes   = 8192
HandshakeTimeoutMs   = 5000
RequestTimeoutMs     = 15000
MaxConnections       = 16
MaxPassthroughBytes  = 262144


# =====================================================================
# [gpu]  when the machine counts as busy
# =====================================================================
#
# Measured idle baseline, 150 samples at 1 Hz, RTX 3070, desktop up and untouched:
#   memory clock 810 MHz (zero variance)   pstate P5 (150 of 150)
#   power 34.55-36.02 W                    utilisation 5-6%
#   memory 388 MiB (zero variance)
#
# Note what that rules out: "utilisation below 5%" can NEVER be true on that
# machine. The naive threshold is not imprecise here, it is unreachable. The
# clock, the pstate and the power figure separate far more cleanly, which is why
# the policy leans on them and treats utilisation as the weakest vote.
#
# THE BUSY SIDE OF THESE IS A MARGIN, NOT A MEASUREMENT. They are set clear of a
# measured idle ceiling, not observed under a game. Run --calibrate before
# trusting them.
MemClockBusyMhz      = 1500
PowerBusyWatts       = 70
UtilGpuBusyPct       = 25
Util3dBusyPct        = 20

# The performance states your card sits in when it is doing nothing. P5 is what
# one 3070 idles at; other cards idle at P8 or P0, and a card that idles at P0
# would make this vote fire constantly. This is the setting most likely to be
# wrong for you and it is here, in config, rather than in the source.
IdlePStates          = P5,P8,P12

# THE PAUSED GAME VETO, and the only signal that catches it. A game sitting at a
# menu draws nothing and still owns its VRAM. Per-process VRAM is [N/A] in
# nvidia-smi under Windows display drivers, so this comes from the Windows
# performance counters instead. Largest thing measured on an idle desktop was the
# compositor at 169 MiB; 512 is three times that and far below what any game holds.
# On a card with much more or much less memory than 8 GiB, revisit it.
ForeignVramBusyMiB   = 512

# Processes allowed to hold GPU memory without being read as a game.
#
# THIS LIST IS FROM ONE PERSON'S DESKTOP AND WILL BE WRONG FOR YOURS. Anything
# you run that holds more than ForeignVramBusyMiB and is not here will make the
# agent yield for ever. `offpeak status --json` shows what it is objecting to
# under foreign_vram, which is how you find out what to add.
VramAllowlist        = dwm,explorer,csrss,ShellHost,SearchHost,StartMenuExperienceHost,ShellExperienceHost,ApplicationFrameHost,SystemSettings,CrossDeviceResume,TextInputHost,SearchApp,System,msedgewebview2,steamwebhelper,steam,steamservice,LogonUI,sihost,ctfmon

# Process names whose presence alone means yield, whether or not they are drawing.
#
# ALSO FROM ONE PERSON'S LIBRARY. This list is hand maintained and will be
# incomplete: Epic, Game Pass, GOG and Battle.net set no Steam RunningAppID, so
# for anything launched from those the VRAM veto above is the only backstop.
GameProcessNames     = cs2,RainbowSix,RainbowSixGame,ReadyOrNot,GRB,VALORANT-Win64-Shipping,VALORANT,LeagueOfLegends

# Anti-cheat services whose running state means a game is up. Measured on one
# machine: Vanguard installs vgk, a kernel driver that is ALWAYS running and
# therefore says nothing, and vgc, a user mode service that starts with the game.
# vgc is the useful one. Add whatever the next one is called.
AntiCheatServices    = vgc


# =====================================================================
# [timing]  detection is fast, release is slow, on purpose
# =====================================================================
#
# A false "busy" costs one job. A false "idle" costs somebody their game. So the
# cooldown is deliberately far longer than the detection window.
BusyConfirmSamples   = 3
ClearCooldownSeconds = 90
YieldGraceSeconds    = 2
FastPollMs           = 1000
# 2000, not 5000: this is the ENTIRE detection latency for an unknown game, which
# is caught by the VRAM veto and nothing else. Reading the counters in process
# costs about 100 ms, so a slower poll bought almost nothing and cost three
# seconds of somebody's frame time.
CounterPollMs        = 2000
# How often the scheduler looks for queued work. On its own thread, never on the
# policy loop, because listing every service's queue is a syscall per service.
SchedulerPollMs      = 500


# =====================================================================
# [limits]  what this machine gives up, state by state and resource by resource
# =====================================================================
#
# The tray and the settings window write this section. It is safe to edit by
# hand; the settings window rewrites the whole block and leaves every other line
# in this file alone.
#
# FIVE STATES. The machine is always in exactly one of them, and each one is
# decidable from a signal that exists rather than from a guess:
#
#   nobodyhome  no console user at all: the sign-in screen, or after a boot and
#               before anybody logs in. Most of a gaming PC's uptime.
#   locked      somebody is signed in and the desktop is locked.
#   idle        signed in, unlocked, and no keyboard or mouse for
#               IdleAfterSeconds. An agent at boot lives in session 0 and cannot
#               measure this on its own, so without the logon helper reporting
#               it this reads as lightuse, never as idle.
#   lightuse    signed in, unlocked, and using the machine. Reading, typing, a
#               browser. This is the only state the CPU ladder has to be careful
#               in, which is why the defaults are careful only here.
#   busy        a game exists, or somebody else's work is using the CPU. Steam
#               has a running app, the anti-cheat service is up, a named game
#               process exists, another process holds VRAM, the foreground
#               window is full screen, or foreign CPU is over ForeignCpuBusyPct
#               for BusyConfirmSamples in a row.
#
# FIVE SETTINGS PER STATE.
#
#   gpu             may a service that wants the card run at all. The GPU's own
#                   detector is still the gate; this is an extra veto on top of
#                   it, so "yes" means "today's behaviour" and "no" means "not
#                   even if it looks free".
#   cpupct          a HARD CAP as a share of the WHOLE MACHINE, not of one core.
#                   Measured on a 16 thread desktop: 50 gave 8.03 cores, 10 gave
#                   1.48. It says how much, never which cores.
#                   0 means DO NOT RUN. Windows rejects a rate of zero, so zero
#                   has to mean stop rather than "capped to nothing".
#   priority        normal, belownormal or idle. Necessary and not sufficient:
#                   against a memory-heavy background job, idle priority ALONE
#                   still cost a foreground workload 40 per cent of its
#                   throughput, because cache eviction has already happened by
#                   the time the scheduler preempts. Use it with a cap.
#   workingsetmib   a ceiling on how much memory the job may hold RESIDENT. Over
#                   it, the JOB is trimmed and pages, rather than the owner's
#                   browser. 0 means no ceiling. Deliberately not a commit cap:
#                   a commit cap kills the job instead of squeezing it, measured
#                   as an access violation rather than a catchable error.
#                   Needs SeIncreaseBasePriorityPrivilege. The agent has it as
#                   SYSTEM; run by hand as an ordinary user it does not, and the
#                   tray says so instead of pretending the cap is in force.
#   minfreemib      an admission check. A job is not STARTED when free physical
#                   memory is already below this plus whatever the service says
#                   it needs. A job not started costs a wait; a job started on a
#                   machine with no headroom costs the owner their session.
#
# Delete any line to get its default back. Delete the whole section for all of
# them. The numbers below ARE the defaults.

# THE POSTURE. A name for the whole matrix below, because twenty-five numbers is
# a form and nobody fills in a form to lend somebody a computer.
#
#   generous   use it unless I am actually gaming
#   balanced   use it while I am away, and stay out of my way when I am here
#   away       never while I am signed in and unlocked
#
# PRECEDENCE, AND IT DOES NOT DEPEND ON LINE ORDER. Profile fills every cell
# below; any limits.<state>.<field> line then overrides that ONE cell, whether it
# appears above this line or below it. If any override differs from the named
# posture, the runner reports the posture as `custom` and the tray says "Custom,
# based on Balanced". Nothing is silently reinterpreted.
#
# A posture of your own goes in a [profile.<id>] section at the bottom of this
# file, in the same shape, and then appears in the tray beside these three. The
# settings window writes one for you.
#
# NOT A PROFILE: Off. That is Mode, the big switch, and a posture called Off
# would give the runner two encodings of one state and a status line reading
# "Auto, posture Off" that nobody could parse.
Profile              = balanced

# How long without input before "signed in" becomes "idle". Five minutes matches
# the shortest screen blank most people leave set, so the state this calls idle
# is one the owner would also call idle.
IdleAfterSeconds     = 300
# Foreign CPU, per cent of the whole machine, at which somebody else counts as
# using it. FOREIGN: our own job's CPU is subtracted exactly from the job
# object's own accounting, so this fires on somebody else's compile and can never
# fire on ours. Set it to 101 to switch the CPU load signal off entirely.
ForeignCpuBusyPct    = 40

# Nobody signed in: the machine is entirely free, and there is nobody to be
# polite to.
limits.nobodyhome.gpu           = yes
limits.nobodyhome.cpupct        = 100
limits.nobodyhome.priority      = normal
limits.nobodyhome.workingsetmib = 0
limits.nobodyhome.minfreemib    = 1024
limits.nobodyhome.admit         = yes

# Signed in but locked: nobody is at it either, so nearly as free. Below normal
# priority is a courtesy to whatever the owner left running, a backup or a
# download, and costs essentially nothing on an idle box.
limits.locked.gpu               = yes
limits.locked.cpupct            = 100
limits.locked.priority          = belownormal
limits.locked.workingsetmib     = 0
limits.locked.minfreemib        = 2048
limits.locked.admit             = yes

# Signed in and idle: at the machine but not touching it. The cap is a hedge
# rather than a limit; it is here so a job does not have the machine flat out at
# the moment somebody puts their hand back on the mouse.
limits.idle.gpu                 = yes
limits.idle.cpupct              = 50
limits.idle.priority            = idle
limits.idle.workingsetmib       = 0
limits.idle.minfreemib          = 4096
limits.idle.admit               = yes

# Light use: the one state where somebody is actually there. Measured against an
# eight thread foreground workload and a memory-heavy background job on a 16
# thread desktop:
#
#   nothing running     median 4.32 ms per unit    7155 units
#   idle priority only  median 10.38 ms            4281 units
#   idle + 50% cap      median 10.38 ms            4391 units   50% buys nothing
#   idle + 25% cap      median 5.93 ms             5701 units
#   idle + 10% cap      median 4.89 ms             6452 units   90% of an idle box
#
# So 10 and not 25, and idle priority as well as the cap rather than instead of
# it. The working set ceiling is against runaway growth rather than a squeeze:
# chatterbox on the CPU was measured at 4,701 MiB resident after loading, so
# 8192 does not normally bind.
limits.lightuse.gpu             = yes
limits.lightuse.cpupct          = 10
limits.lightuse.priority        = idle
limits.lightuse.workingsetmib   = 8192
limits.lightuse.minfreemib      = 6144
limits.lightuse.admit           = yes

# Somebody is using it: hands off.
#
# BUSY IS SPLIT BY RESOURCE, which is why this row bites far less often than it
# reads. A game contends the CARD and leaves twelve threads idle; a compile
# contends the PROCESSOR and leaves the card at five per cent. When only one of
# them is contended the OTHER column falls back to the light-use row above,
# never to anything more generous, because a game is the strongest evidence
# there is that somebody is at the machine. So this row in full is what an
# unexplained busy gets, and what a game plus a compile together get.
#
# cpupct 0 means DO NOT RUN. Windows has no zero cap - SetInformationJobObject
# rejects a CpuRate of 0 with INVALID_ARGS - so zero has to mean stop. The
# generous posture ships 10 here instead, on the argument that a CPU yield
# throttles rather than kills and a warm job has already paid a 22 second model
# load. This is the one cell in the grid that has never been tested under a real
# game, so balanced ships the cautious reading.
#
# admit = no is what keeps those two apart: hold the job that is already
# running, start nothing new. MinFreeMib could only have said that with a number
# so large it would have been a lie about memory.
limits.busy.gpu                 = no
limits.busy.cpupct              = 0
limits.busy.priority            = idle
limits.busy.workingsetmib       = 0
limits.busy.minfreemib          = 0
limits.busy.admit               = no


# =====================================================================
# [service.<id>]  what this runner can do
# =====================================================================
#
# NOTHING BELOW IS INSTALLED. Every section below ships with Enabled = false, and the
# agent will not fetch, launch or even create a queue directory for a service
# that is not opted in. A base install is one 120 KB executable that downloads
# nothing; a machine whose owner never asks for speech never sees a byte of torch.
#
# Three states, and the CLI and the API report all three separately:
#
#   known      there is a section for it here. Costs nothing.
#   installed  its provisioning ran and left a marker. Real disk committed.
#   ready      installed AND Enabled = true. The scheduler will run it.
#
# and separately, because it is a property of the MACHINE and not of a service:
# whether the GPU is free right now. A client that cannot tell "speech is not
# installed" from "somebody is gaming" retries for ever against a runner that was
# never going to say yes.
#
#   offpeak service list             what is known, and what each would cost
#   offpeak service install echo     fetch it, then turn it on
#   offpeak service cost             what each one is using, measured
#   offpeak service remove echo      delete it and reclaim the disk
#
# Adding a service of your own is one section here plus one controller script and
# no C# at all. See docs/ADDING-A-SERVICE.md.

# The one that needs no GPU and no downloads worth mentioning. Install this
# first: it exercises the entire path - submit, schedule, run, yield, artefact -
# in about 25 MB, so you find out whether this program works on your machine
# before you spend six gigabytes finding out whether speech does.
[service.echo]
Enabled              = false
Description          = burns CPU for a few seconds and writes the text back
Priority             = 5
Labels               = test,cpu,no-gpu
YieldGraceSeconds    = 2
SizeHint             = about 25 MB (an embeddable CPython, no packages)
Provision            = echo\provision.ps1
# Written by the provisioning script. Until then this path does not exist, which
# is exactly what makes the service read as known rather than installed.
Command              = %RUNTIME%\echo\python\python.exe
Arguments            = "%SCRIPTS%\echo\controller.py" --queue "%QUEUE%"

# Speech on the GPU. THE EXPENSIVE ONE, and the reason opting in exists at all.
[service.chatterbox]
Enabled              = false
Description          = Chatterbox multilingual text to speech
Priority             = 10
Labels               = speech,tts,audio
YieldGraceSeconds    = 2
SizeHint             = about 8.1 GB (5.0 GB of torch cu126 and friends, 3.0 GB of weights)
Provision            = chatterbox\provision.ps1
ProvisionArguments   = -Engine multilingual
Command              = %INSTALL%\venv\Scripts\python.exe
Arguments            = "%SCRIPTS%\chatterbox\controller.py" --queue "%QUEUE%" --engine multilingual
# THE TREE, NAMED RATHER THAN DEFAULTED, because two other sections point at this
# same one and a default that only one of them can spell is a default that will be
# changed here and forgotten there. %RUNTIME%\chatterbox is also what this would
# have defaulted to, so writing it changes nothing on an existing install.
InstallDir           = %RUNTIME%\chatterbox
ReadyMarker          = %INSTALL%\.installed
# Which gate the scheduler puts this behind: gpu waits for the GPU detector, cpu
# waits only for the limits matrix. A CPU service used to sit out a ninety second
# cooldown caused by a game on a card it never touched.
#
# The controller itself takes --device auto by default, so it uses the card when
# there is one and the processor when there is not, and publishes which in its
# manifest. Set this to cpu if you want to sell the processor on a machine that
# also has a card you are keeping for yourself.
Device               = gpu
# Roughly how much system memory this needs resident, for the admission check.
# Measured on a Ryzen 7 5700X3D with 31.9 GiB: 4,701 MiB after the model loaded,
# on the CPU. Rounded up, because generation takes more than loading does.
NeedsMemoryMib       = 6144

# THE SAME SPEECH, ON THE PROCESSOR. One controller file, two service ids.
#
# WHY TWO IDS AND NOT ONE SERVICE WITH A FLAG. Four structural reasons, none of
# them stylistic:
#
#   the queue is per service, one directory and one JobStore per id
#   the manifest is per service, and unit_seconds genuinely differs by about
#     three times between devices, so one manifest cannot honestly carry both
#   Priority and YieldGraceSeconds are per service, and a CPU job that is
#     throttled rather than killed wants a different grace from one that has a
#     CUDA context to tear down
#   the client already selects by service id, so nothing is invented for it
#
# NO SECOND VENV AND NO EXTRA DISK, AND NOW THE FILE ACTUALLY SAYS SO. The CUDA
# torch wheels already contain the complete CPU backend, so this runs out of the
# same runtime\chatterbox tree that [service.chatterbox] provisioned. If you
# enable this one and not the GPU one, provisioning still runs once and installs
# the same thing.
#
# THAT CLAIM USED TO BE FALSE, and it is worth knowing why, because it is the
# reason InstallDir and ReadyMarker are written out below. Only Command,
# Arguments and WorkingDir expanded %RUNTIME%, so InstallDir DEFAULTED to
# runtime\chatterbox-cpu while Command pointed into runtime\chatterbox. The
# comment promised a shared tree; the code provisioned a second complete 8 GB
# one beside it, looked for a marker in a directory the shared provisioning
# never wrote to, and reported "not installed" for ever. Config.Resolve now
# expands both fields, so the sharing the comment always described is the
# sharing that happens.
#
# WHEN THIS IS WORTH ENABLING. Measured on a Ryzen 7 5700X3D: see docs/CPU-
# LIMITS.md for the realtime factor and what it does to the machine while it
# runs. The honest summary is that a desktop CPU is a FALLBACK for when the card
# is busy, not a replacement for it - but a fallback that keeps earning while a
# game has the GPU is the entire point of selling both.
[service.chatterbox-cpu]
Enabled              = false
Description          = Chatterbox text to speech, on the processor
# Below the GPU one on purpose. When both have queued work and both may run, the
# card should get the job it can finish several times faster.
Priority             = 8
Labels               = speech,tts,audio,cpu
# Longer than the GPU's 2 s. A CPU controller has no CUDA context to tear down,
# so the only thing the grace period buys is finishing the segment in flight -
# and a segment on the processor takes several times as long as one on the card.
YieldGraceSeconds    = 6
SizeHint             = nothing extra; shares the chatterbox runtime
Provision            = chatterbox\provision.ps1
ProvisionArguments   = -Engine multilingual
Command              = %INSTALL%\venv\Scripts\python.exe
# --device cpu BY NAME, not auto. On a machine with a card, auto would resolve to
# cuda and this service would quietly become a second GPU service competing with
# the first.
Arguments            = "%SCRIPTS%\chatterbox\controller.py" --queue "%QUEUE%" --engine multilingual --device cpu
Device               = cpu
# THE SAME TREE AND THE SAME MARKER AS [service.chatterbox]. Same weights, same
# venv, same download - so "installed" is one fact about one tree and not two,
# and installing either one installs both. `offpeak service remove` knows they
# share and will not delete the tree out from under the other; see Install.cs.
InstallDir           = %RUNTIME%\chatterbox
ReadyMarker          = %INSTALL%\.installed
# THE PEAK, NOT THE STEADY STATE, and the difference is the whole reason this
# number exists. Measured on a Ryzen 7 5700X3D with 31.9 GiB, sampling every
# three seconds through one real synthesis on the CPU:
#
#   t+13s   2,375 MiB     weights coming off disk
#   t+19s   5,698 MiB
#   t+22s   7,238 MiB     PEAK, while the checkpoint is still held
#   t+25s   4,586 MiB     steady state, and it stays there for the whole job
#
# Sizing this at the 4,586 MiB steady state would admit a job that then asks for
# another 2.6 GiB fifteen seconds later, which is exactly the moment the owner's
# browser goes to disk. Paging is felt in a way CPU contention is not: a
# throttled job makes things slower, a machine that is swapping makes them stop.
# So it is the peak, rounded up.
#
# The admission check adds this to the row's MinFreeMib, so during light use this
# service needs 6144 + 7168 = 13,312 MiB free before it will start.
NeedsMemoryMib       = 7168

# THE SAME SPEECH ENGINE FAMILY, THE OTHER CHECKPOINT. Chatterbox Turbo.
#
# WHAT YOU GET AND WHAT YOU GIVE UP, measured on an RTX 3070 8 GB by this project
# on this hardware, and none of it is a vendor claim:
#
#   chatterbox        0.65x realtime      4,199 MiB VRAM     23 languages
#   chatterbox-turbo  1.54x realtime      3,805 MiB VRAM     English only
#
# 2.36 times quicker, past realtime, and less VRAM. The bill is paid in controls:
#
#   NO LANGUAGE. generate() has no language_id parameter at all. Passing one is a
#     TypeError, not a fallback. It speaks English.
#   NO EXAGGERATION AND NO CFG_WEIGHT. The checkpoint sets hp.emotion_adv = False,
#     so the emotion conditioning layer is never built, and inference_turbo has no
#     classifier-free-guidance path. Both arguments are still ACCEPTED by
#     generate() and then logged as a warning and discarded, which is worse than
#     refusing them. This controller refuses them by name; see --engine turbo.
#   QUIETER BY DESIGN. Output is normalised to -27 LUFS.
#   A REFERENCE CLIP MUST BE LONGER THAN 5 SECONDS. Turbo asserts it itself, so a
#     shorter one fails the job rather than producing something odd.
#
# temperature, top_p, top_k and repetition_penalty survive and mean what they
# always meant.
[service.chatterbox-turbo]
Enabled              = false
Description          = Chatterbox Turbo: English only, no expression controls, 2.36x baseline on a 3070
Labels               = speech,tts,audio,turbo
Device               = gpu
# BELOW chatterbox's 10, ON PURPOSE. There is one controller per device group and
# no preemption, so when both have queued work the higher number takes the card
# and the other waits. Baseline serves 23 languages and two expression controls
# that have NO substitute anywhere; turbo's only missing piece is speed, and a
# caller who cannot have the card still gets turbo on a processor. The engine with
# the worse fallback wins the scarce resource.
#
# Reversing this starves baseline off the card under a steady turbo trickle, and
# every starved baseline job then reports machine_busy - THE SAME STRING A GAME
# PRODUCES - so a week of turbo hogging is indistinguishable from a week of
# gaming, by anyone reading either end.
Priority             = 9
# The same 2 s as [service.chatterbox], and for the same reason: what the grace
# period buys on a GPU service is tearing down the CUDA context, and turbo has
# exactly the same one. It is NOT time to finish the segment in flight - a turbo
# segment is 2.36x quicker than a baseline segment, so if 2 s is right there it is
# more than right here. A longer grace on a faster engine is somebody's game
# waiting for nothing.
YieldGraceSeconds    = 2
# MEASURED FROM THE REPOSITORY, not from the model card. from_pretrained fetches
# ResembleAI/chatterbox-turbo with allow_patterns *.safetensors *.json *.txt *.pt
# *.model, which is 3.77 GiB across ten files:
#
#   t3_turbo_v1.safetensors     1,827 MiB   the turbo T3
#   s3gen_meanflow.safetensors  1,016 MiB   the vocoder turbo actually loads
#   s3gen.safetensors           1,008 MiB   fetched by the pattern, never loaded
#   ve.safetensors + tokenizer      7 MiB
#
# AND IT IS THE INCREMENTAL COST, not the total. torch cu126, CUDA, the CPython
# and the whole 5 GB virtual environment are already there from
# [service.chatterbox] and are SHARED - see InstallDir below. Installing this
# after that one costs 3.8 GB, not 12.
SizeHint             = about 3.8 GB of extra weights (the 5 GB torch runtime is shared with chatterbox)
# THE SAME 6144 AS [service.chatterbox], and the number is SYSTEM memory for the
# admission check, not VRAM. Turbo needs less VRAM than baseline - 3,805 MiB
# against 4,199 - but that is the card, and this row decides whether starting the
# job would push the OWNER's machine into paging. Turbo's resident set has never
# been measured separately and its weights are the same order as baseline's, so
# this is baseline's measured figure until somebody measures this one. Sizing it
# down from a VRAM reading would admit a job on a full machine on the strength of
# a number about a different resource, and paging is felt in a way a slow job is
# not. The controller publishes the measured memory_mib in its manifest, which is
# what corrects this rather than a guess here.
NeedsMemoryMib       = 6144
Provision            = chatterbox\provision.ps1
ProvisionArguments   = -Engine turbo
Command              = %INSTALL%\venv\Scripts\python.exe
# --idle-exit-seconds 240, NOT the default 60. A controller exits when it has been
# idle for a while so another service can have the card, and that is right. But
# turbo's cold load is 67.5 s against 20.0 s warm; a 60 s idle window in front of
# a 68 s reload is a card that spends more time loading than speaking. 240 is
# still short against the length of a real idle evening.
Arguments            = "%SCRIPTS%\chatterbox\controller.py" --queue "%QUEUE%" --engine turbo --idle-exit-seconds 240
# SHARES [service.chatterbox]'s TREE ON PURPOSE, and this is where the 3.8 GB
# above comes from. tts_turbo.py is already inside the installed chatterbox-tts
# 0.1.7 wheel - same package, same venv, same torch - so the only new bytes are
# the turbo checkpoint. A tree of its own would be 8.8 GB instead of 3.8 GB for
# one different set of weights.
#
# TWO CONSEQUENCES OF SHARING, WRITTEN DOWN HERE RATHER THAN DISCOVERED LATER:
#
#   `service cost` measures a DIRECTORY, so this row and chatterbox's row both
#     report the whole shared tree. Both figures are true; adding them is not, so
#     the total counts each tree once and the list says which rows share one.
#   `service remove` on either one would delete the other's weights, the shared
#     virtual environment and its python.exe, leaving that service Enabled = true
#     pointing at an interpreter that is gone. So removal is guarded: removing
#     either clears only its OWN ready marker and leaves the tree, and --purge
#     refuses until every service sharing the tree has been removed.
InstallDir           = %RUNTIME%\chatterbox
# A DISTINCT MARKER INSIDE A SHARED TREE, and it is what keeps the two install
# states separable. chatterbox-cpu shares chatterbox's marker because it is
# genuinely the same download; turbo's weights are a different Hugging Face
# repository sharing no blobs with it, so it can be installed and removed on its
# own. provision.ps1 -Engine turbo writes this file as its LAST act.
ReadyMarker          = %INSTALL%\.installed-turbo

# A THIRD SPEECH ENGINE, AND THE FIRST ONE THAT IS NOT CHATTERBOX AT ALL.
# Voxtral-4B-TTS, Mistral's checkpoint, run at int4 through the third-party
# voxtral-int4 wrapper (torchao tinygemm with the HQQ parameter search).
#
# WHAT YOU GET AND WHAT YOU PAY, measured on an RTX 3070 8 GB by this project on
# this hardware, and none of it is a vendor claim:
#
#   chatterbox        0.635x realtime    4,199 MiB VRAM    23 languages, cloning
#   chatterbox-turbo  1.594x realtime    3,805 MiB VRAM    English only, cloning
#   voxtral           0.104x realtime    3,500 MiB VRAM     9 languages, 20 voices
#
# 0.104x IS THE HEADLINE AND IT IS NOT A TYPO. A twenty-second clip is about
# three and a half minutes of GPU. That is at the quality settings below; at the
# wrapper's own default of 8 flow steps it is 0.354x, still slower than
# realtime. So this is never a synchronous route and never streamed - a client
# submits a job and comes back for it.
#
# WHAT IT CANNOT DO, and all of it is refused BY NAME rather than ignored:
#
#   NO CLONING. Twenty speaker embeddings ship inside the checkpoint as .pt
#     tensors and there is no speaker encoder anywhere in it. A reference clip
#     cannot become a voice here even in part, so `voice` is REQUIRED and
#     `reference_sha256` is refused.
#   NO EXAGGERATION, NO CFG_WEIGHT, NO TEMPERATURE. It is a flow-matching
#     checkpoint with no emotion conditioning of any kind. Its delivery dials
#     are cfg_alpha and flow_steps, which are neither of those on another scale.
#   NO LANGUAGE PARAMETER. The language is carried by the voice embedding:
#     de_female is German because of which tensor it is. A language field could
#     only agree with the voice or contradict it.
#
# TWENTY VOICES, NINE LANGUAGES: ar_male, casual_female, casual_male,
# cheerful_female, de_female, de_male, es_female, es_male, fr_female, fr_male,
# hi_female, hi_male, it_female, it_male, neutral_female, neutral_male,
# nl_female, nl_male, pt_female, pt_male. The controller reads them off the disk
# rather than carrying a list, and publishes them in its manifest, so nothing
# here or on any client needs a second copy.
[service.voxtral]
Enabled              = false
Description          = Voxtral-4B-TTS int4: twenty fixed preset voices, nine languages, 0.104x realtime
Labels               = speech,tts,audio,preset-voice
Device               = gpu
# BELOW BOTH CHATTERBOX ENGINES. There is one controller per device group and no
# preemption, so when several have queued work the higher number takes the card
# and the others wait. This is the slowest engine on the machine by a factor of
# six and the one whose jobs are longest, so a Voxtral queue that outranked
# chatterbox would hold the card for hours while every cloning job waited - and a
# starved job reports machine_busy, THE SAME STRING A GAME PRODUCES, so a week of
# that is indistinguishable from a week of gaming by anyone reading either end.
Priority             = 7
# The same 2 s as the other GPU services, and for the same reason: what the grace
# period buys on a GPU service is tearing down the CUDA context, which this has
# exactly as much of as they do. It is NOT time to finish the work in flight -
# the controller checks the yield flag between FRAMES, about every 740 ms, so it
# stops on its own well inside two seconds. A longer grace here would be
# somebody's game waiting for nothing.
YieldGraceSeconds    = 2
# ABOUT 12.2 GB, NONE OF IT SHARED, and the honesty matters more here than
# anywhere else in this file. 7.49 GB of weights, 4.59 GB of a SECOND torch, and
# its own 0.06 GB CPython. It cannot share [service.chatterbox]'s tree:
# chatterbox-tts 0.1.7 pins torch==2.6.0 and this needs 2.14.0, and
# src/Install.cs:325 makes one tree one virtual environment with no per-service
# override. Quoting an incremental figure the way chatterbox-turbo does would be
# quoting a saving that does not exist. Peak during the install is about
# 16.7 GB, before the wheel cache is reclaimed.
#
# IT IS AN UPPER BOUND MEASURED ON A REAL TREE, not an estimate: the environment
# those 4.59 GB came from is the one the audio was measured on and it held 68
# packages, where the lock resolves 35. `offpeak service cost` measures yours.
SizeHint             = up to 12.2 GB, none of it shared (7.5 GB of weights, 4.6 GB of a second torch cu126)
# SYSTEM memory for the admission check, not VRAM. The load reads 8.0 GB of BF16
# off disk and holds it while it quantises, so the resident peak is the BF16
# model plus torch itself. Rounded up from that, because a machine that starts
# paging is felt in a way a slow job is not, and the controller republishes the
# measured figure in its manifest as soon as it has one.
NeedsMemoryMib       = 10240
Provision            = voxtral\provision.ps1
Command              = %INSTALL%\venv\Scripts\python.exe
# -X utf8 IS LOAD-BEARING AND IT IS NOT A STYLE CHOICE. voxtral-int4's
# generate.py opens tekken.json with no encoding=, so Windows uses cp1252 and
# the tokeniser dies on a file that is 14.9 MB of base64 and Unicode - measured,
# both ways, on this machine. There is no per-service environment key in this
# file and adding one would mean recompiling the agent to add a service, which
# is the one thing this design promises never to need. -X utf8 is PYTHONUTF8=1
# as an argument. The controller asserts sys.flags.utf8_mode at start and exits
# with that same sentence if this line is ever edited, so the failure is one
# line rather than four frames deep inside tiktoken.
#
# --flow-steps 32 IS THE MAIN QUALITY KNOB AND IT WAS ARRIVED AT BY LISTENING.
# 32 was clearly best on this owner's ear, 16 close behind, 8 and 4 audibly
# worse. The wrapper defaults to 3 and its repository to 8. It is the difference
# between three and a half minutes and one, and it is a taste decision rather
# than a performance one - which is exactly why it is here and not in the code.
# A job may send its own flow_steps; this is what it gets when it does not.
#
# --cfg-alpha 1.2 is full classifier-free guidance. 1.0 is documented upstream
# as faster and garbled, which is why the floor is 1.0 and not 0.
#
# --group-size 32 against the shipped 64: finer quantisation, and it cost no
# measurable VRAM. Consumed once inside the load, so it is not a job parameter.
#
# --max-frames 2000 is 160 seconds of audio per segment at 12.5 Hz. The
# wrapper's fast path defaults to 500, a 40-second ceiling that silently
# truncates a long sentence; the standard path uses 2000.
#
# --low-pass-hz 0 turns OFF the 6th-order Butterworth at 10 kHz that the
# wrapper applies to every file. The owner heard it in one pass and called it a
# pilot mic. Set it to 10000 to have it back.
#
# --fade-ms 120 is a squared fade-in over the start of every segment. There is a
# known warm-up glitch in the first frames (HF discussion #20) and the wrapper's
# own trim only catches a run of identical leading codes. DROPPING FRAMES
# INSTEAD WAS TRIED AND IT ATE THE FIRST WORD; a fade buries the burst under an
# amplitude envelope and every sample of speech survives.
#
# --min-free-vram-mib 8400 because the load PEAKS AT 8265 MiB ON AN 8192 MiB
# CARD - it puts the whole model on the device in BF16 before quantising - and
# it survived once with 455 MiB of desktop resident. Below this the controller
# refuses the JOB, with both numbers in the message, rather than dying and being
# relaunched every 500 ms for ever.
#
# --idle-exit-seconds 600, not the default 60. A controller exits when it has
# been idle so another service can have the card, and that is right - but the
# cold load here is 63 s, every time, because there is no pre-quantised
# checkpoint. A one-minute window in front of a one-minute load is a card that
# spends its evening loading.
Arguments            = "-X" "utf8" "%SCRIPTS%\voxtral\controller.py" --queue "%QUEUE%" --group-size 32 --max-frames 2000 --flow-steps 32 --cfg-alpha 1.2 --fade-ms 120 --low-pass-hz 0 --min-free-vram-mib 8400 --idle-exit-seconds 600
# ITS OWN TREE, AND IT IS FORCED RATHER THAN CHOSEN. See SizeHint: one tree is
# one virtual environment and one virtual environment cannot hold two torches.
InstallDir           = %RUNTIME%\voxtral
ReadyMarker          = %INSTALL%\.installed

# %RUNTIME%, %SCRIPTS% and %QUEUE% above are expanded by the agent, so this file
# has no absolute path in it and works unedited on anybody's machine:
#
#   %RUNTIME%  RuntimeRoot, where services put what they download
#              (default %LOCALAPPDATA%\offpeak\runtime)
#   %SCRIPTS%  ScriptsRoot, where the controller scripts were installed
#              (default %LOCALAPPDATA%\offpeak\services)
#   %QUEUE%    this service's own queue directory
#
# Write absolute paths instead if you would rather; nothing requires these.
