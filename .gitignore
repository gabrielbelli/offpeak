dist/

# Calibration output lands here as CSV and is not committed by default - a
# twenty-minute trace is the user's own data and can be large.
*.csv

# BUT the test fixtures are the evidence and the tests, so they are committed.
# Without this exception the policy suite would ship with no fixtures and pass
# vacuously, which is worse than having no tests at all.
!tests/fixtures/*.csv

# What a service downloads: about 8 GiB of torch, CUDA and weights for speech
# alone. uv.lock and pyproject.toml are committed; everything they install is
# not. In a real install this lives in %LOCALAPPDATA%\idlegpu\runtime and never
# in a checkout, but a provisioning script run by hand with -Root . would put it
# here.
runtime/
services/*/venv/
services/*/python/
services/*/models/
services/*/cache/
services/*/bin/
services/*/.installed
services/*/uv.exe
__pycache__/
*.pyc

# Queue directories, if anyone points one at a checkout.
queue/
queues/

# Python test and bytecode caches from the service controllers.
__pycache__/
*.pyc
.pytest_cache/
